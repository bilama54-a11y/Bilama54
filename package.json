{
  "name": "matchlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-ocr.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/setup-ocr.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/smoke-test.mjs",
    "build:portable": "node scripts/setup-ocr.mjs && node scripts/build-portable.mjs",
    "test:portable": "node scripts/test-portable.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.0"
  }
}
